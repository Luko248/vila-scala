---
import interiorKitchen from '../assets/images/interior-kitchen.jpg';

import Breadcrumbs from '../components/Breadcrumbs.astro';
import Button from '../components/Button.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import UnitsTable from '../components/UnitsTable.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

import { path, t, withBase, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const c = dict.pricing;
---

<BaseLayout
  locale={locale}
  routeKey="pricing"
  title={c.seoTitle}
  description={c.seoDescription}
  image={withBase("/og/home.jpg")}
  overHero
>
  <Hero
    image={interiorKitchen}
    alt={locale === 'cs'
      ? 'Kuchyňský ostrůvek v travertinovém provedení v bytě Vila SCALA'
      : 'Travertine kitchen island in a Vila SCALA apartment'}
    title={c.title}
    subtitle={c.lead}
  />

  <Breadcrumbs locale={locale} trail={[]} current={dict.nav.pricing} />

  <Section class="pt-10 sm:pt-14" labelledby="price-table-title">
    <SectionHeading id="price-table-title" index="01" eyebrow={dict.nav.pricing} title={dict.unitsPage.tableTitle} />
    <UnitsTable locale={locale} class="mt-10" />

    <h3 class="reveal mt-16 text-2xl">{c.parkingTitle}</h3>
    <div class="reveal mt-6 overflow-x-auto">
      <table class="w-full min-w-[30rem] border-collapse text-left text-sm">
        <caption class="sr-only">{c.tableCaption}</caption>
        <thead>
          <tr class="border-b border-line-strong">
            <th scope="col" class="py-3 pr-4 font-semibold">{c.colItem}</th>
            <th scope="col" class="py-3 pr-4 font-semibold">{c.colSpec}</th>
            <th scope="col" class="py-3 text-right font-semibold">{c.colPrice}</th>
          </tr>
        </thead>
        <tbody>
          {
            c.parking.map((p) => (
              <tr class="border-b border-line">
                <th scope="row" class="py-4 pr-4 font-medium">{p.name}</th>
                <td class="py-4 pr-4 text-muted">{p.spec}</td>
                <td class="py-4 text-right font-medium whitespace-nowrap tabular-nums">{p.price}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="reveal mt-4 text-sm text-muted">{c.parkingNote}</p>

    <aside class="reveal mt-12 rounded-card border border-line bg-surface p-6 sm:p-8">
      <h3 class="text-xl">{c.noteTitle}</h3>
      <p class="mt-3 max-w-3xl text-muted">{c.noteBody}</p>
    </aside>
  </Section>

  <Section tone="surface" labelledby="standards-title">
    <SectionHeading id="standards-title" index="02" eyebrow={dict.meta.siteName} title={c.standardsTitle} lead={c.standardsLead} />
    <dl class="mt-12 grid gap-x-12 gap-y-6 md:grid-cols-2">
      {
        c.standards.map((s, i) => (
          <div class="reveal border-t border-line pt-4" data-reveal-delay={(i % 2) * 60}>
            <dt class="font-medium">{s.name}</dt>
            <dd class="mt-1 text-muted">{s.body}</dd>
          </div>
        ))
      }
    </dl>
    <p class="reveal mt-10 font-display text-2xl">{c.standardsClosing}</p>
    <div class="reveal mt-8 flex flex-wrap gap-3">
      <Button href={withBase("/docs/vila-scala-standardy.pdf")} download>{dict.documents.standardsFile}</Button>
      <Button href={path('contact', locale)} variant="secondary">{dict.cta.contactUs}</Button>
    </div>
  </Section>

  <Section labelledby="areas-title">
    <SectionHeading id="areas-title" index="03" eyebrow={dict.nav.pricing} title={c.areasTitle} />
    <dl class="prose-vs mt-10 grid gap-8">
      {
        c.areas.map((a, i) => (
          <div class="reveal" data-reveal-delay={i * 60}>
            <dt class="font-display text-2xl">{a.name}</dt>
            <dd class="mt-2 text-muted">{a.body}</dd>
          </div>
        ))
      }
    </dl>
  </Section>
</BaseLayout>
