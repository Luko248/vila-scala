---
import { Image } from 'astro:assets';

import exteriorDay from '../assets/images/exterior-day.jpg';
import viewSvratka from '../assets/images/view-svratka.jpg';
import terrace2 from '../assets/images/terrace-2.jpg';
import rockGarden from '../assets/images/rock-garden.jpg';

import Breadcrumbs from '../components/Breadcrumbs.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

import { path, t, withBase, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const c = dict.about;
---

<BaseLayout
  locale={locale}
  routeKey="about"
  title={c.seoTitle}
  description={c.seoDescription}
  image={withBase("/og/home.jpg")}
  overHero
>
  <Hero
    image={exteriorDay}
    alt={locale === 'cs'
      ? 'Denní pohled na fasádu viladomu Vila SCALA s balkony a zelení'
      : 'Daytime view of the Vila SCALA facade with balconies and greenery'}
    title={c.title}
    subtitle={c.lead}
  />

  <Breadcrumbs locale={locale} trail={[]} current={dict.nav.about} />

  <Section labelledby="about-title" class="pt-10 sm:pt-14">
    <SectionHeading id="about-title" index="01" eyebrow={dict.meta.siteName} title={c.lead} />
    <div class="mt-12 grid gap-12 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:gap-20">
      <p class="reveal prose-vs text-lg text-muted" data-reveal-delay="120">{c.intro}</p>
      <div class="reveal flex flex-wrap items-start gap-3 lg:justify-end" data-reveal-delay="200">
        <Button href={path('units', locale)}>{dict.cta.viewUnits}</Button>
        <Button href={path('contact', locale)} variant="secondary">{dict.cta.contact}</Button>
      </div>
    </div>
  </Section>

  <Section tone="surface" labelledby="pillars-title">
    <SectionHeading id="pillars-title" index="02" eyebrow={dict.nav.about} title={c.pillarsTitle} />
    <div class="mt-14 grid gap-x-12 gap-y-12 md:grid-cols-2">
      {
        c.pillars.map((p, i) => (
          <article class="reveal border-t border-line-strong pt-7" data-reveal-delay={(i % 2) * 80}>
            <h3 class="text-2xl">{p.title}</h3>
            <p class="mt-4 text-muted">{p.body}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <Section labelledby="location-title">
    <SectionHeading id="location-title" index="03" eyebrow="Jundrov" title={c.locationTitle} lead={c.locationLead} />

    <div class="mt-14 grid gap-12 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:gap-16">
      <div class="grid gap-10">
        {
          c.locationSections.map((s, i) => (
            <article class="reveal" data-reveal-delay={i * 70}>
              <h3 class="text-2xl">{s.title}</h3>
              <p class="mt-3 text-muted">{s.body}</p>
            </article>
          ))
        }
        <p class="reveal border-t border-line pt-7 font-display text-2xl">{c.closing}</p>
      </div>

      <div class="reveal grid gap-4 self-start sm:grid-cols-2 lg:grid-cols-1">
        <Image
          src={viewSvratka}
          alt={locale === 'cs'
            ? 'Výhled na meandr řeky Svratky a okolní zeleň'
            : 'View over the meander of the Svratka river and the surrounding greenery'}
          widths={[400, 700, 1000]}
          sizes="(min-width: 1024px) 40vw, 46vw"
          loading="lazy"
          class="aspect-[3/2] w-full rounded-card object-cover"
        />
        <Image
          src={terrace2}
          alt={locale === 'cs'
            ? 'Panoramatický pohled z terasy do zeleně'
            : 'Panoramic view from the terrace into the greenery'}
          widths={[400, 700, 1000]}
          sizes="(min-width: 1024px) 40vw, 46vw"
          loading="lazy"
          class="aspect-[3/2] w-full rounded-card object-cover"
        />
        <Image
          src={rockGarden}
          alt={locale === 'cs'
            ? 'Skalní zahrada s cortenovými prvky u domu'
            : 'Rock garden with corten details beside the building'}
          widths={[400, 700, 1000]}
          sizes="(min-width: 1024px) 40vw, 46vw"
          loading="lazy"
          class="aspect-[3/2] w-full rounded-card object-cover sm:col-span-2 lg:col-span-1"
        />
      </div>
    </div>
  </Section>
</BaseLayout>
