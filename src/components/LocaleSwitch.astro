---
import { locales, path, t, type Locale, type RouteKey } from '../i18n';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  slug?: string;
}
const { locale, routeKey, slug } = Astro.props;
const dict = t(locale);
---

<nav aria-label={dict.a11y.switchLanguage} class="flex items-center rounded-full border border-line p-0.5">
  {
    locales.map((l) => {
      const active = l === locale;
      return (
        <a
          href={path(routeKey, l, slug)}
          hreflang={l === 'cs' ? 'cs-CZ' : 'en'}
          lang={l === 'cs' ? 'cs-CZ' : 'en'}
          aria-current={active ? 'true' : undefined}
          class:list={[
            'grid h-10 min-w-11 place-items-center rounded-full px-2 text-sm font-medium transition-colors duration-200',
            active ? 'bg-accent text-accent-contrast' : 'text-muted hover:bg-surface hover:text-text',
          ]}
        >
          <span class="sr-only">{l === 'cs' ? 'Čeština' : 'English'}</span>
          <span aria-hidden="true">{l === 'cs' ? 'CS' : 'EN'}</span>
        </a>
      );
    })
  }
</nav>
