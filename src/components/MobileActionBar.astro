---
import { site } from '../data/site';
import { path, t, type Locale, type RouteKey } from '../i18n';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
}

const { locale, routeKey } = Astro.props;
const dict = t(locale);
const isDecisionPage = routeKey === 'units' || routeKey === 'unit';
const primaryHref = isDecisionPage
  ? path('contact', locale)
  : routeKey === 'home'
    ? '#byty'
    : path('units', locale);
const primaryLabel = isDecisionPage ? dict.cta.contactUs : dict.cta.viewUnits;
---

<aside
  data-mobile-actions
  aria-label={`${dict.nav.units} / ${dict.nav.contact}`}
  class="no-print fixed inset-x-0 bottom-0 z-40 border-t border-line bg-bg/92 p-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] shadow-[0_-10px_30px_-20px_rgb(20_17_15/0.45)] backdrop-blur-xl transition-[opacity,transform] duration-300 lg:hidden"
>
  <div class="mx-auto grid max-w-lg grid-cols-[1fr_auto] gap-2">
    <a
      href={primaryHref}
      class="button-link inline-flex min-h-12 items-center justify-center rounded-full bg-accent px-5 text-sm font-medium text-accent-contrast"
    >
      {primaryLabel}
    </a>
    <a
      href={`tel:${site.phone}`}
      class="button-link inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-line-strong px-5 text-sm font-medium text-text"
    >
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.33 1.84.56 2.8.69A2 2 0 0 1 22 16.92Z" />
      </svg>
      {dict.cta.call}
    </a>
  </div>
</aside>

<style is:global>
  @media screen and (max-width: 1023px) {
    body {
      padding-bottom: calc(4rem + env(safe-area-inset-bottom));
    }
  }
</style>
