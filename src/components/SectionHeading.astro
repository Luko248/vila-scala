---
export interface Props {
  id?: string;
  /** Two-digit index printed in the margin, editorial style. */
  index?: string;
  eyebrow?: string;
  title: string;
  lead?: string;
  as?: 'h1' | 'h2';
  tone?: 'default' | 'invert';
}
const { id, index, eyebrow, title, lead, as: Tag = 'h2', tone = 'default' } = Astro.props;
---

<div class="grid gap-x-10 gap-y-6 md:grid-cols-[auto_minmax(0,1fr)]">
  {
    (index || eyebrow) && (
      <p
        class:list={[
          'reveal meta flex items-center gap-3 md:pt-4',
          tone === 'invert' ? 'text-white/60' : 'text-muted',
        ]}
      >
        {index && <span class="text-accent-text">{index}</span>}
        {index && eyebrow && <span aria-hidden="true" class="h-px w-8 bg-current opacity-40" />}
        {eyebrow && <span>{eyebrow}</span>}
      </p>
    )
  }

  <div class="max-w-4xl">
    <Tag id={id} class:list={[Tag === 'h1' ? 'text-display' : 'text-h2']}>
      <span class="reveal-line"><span>{title}</span></span>
    </Tag>
    {
      lead && (
        <p
          class:list={[
            'reveal mt-6 max-w-2xl text-lg sm:text-xl',
            tone === 'invert' ? 'text-white/80' : 'text-muted',
          ]}
          data-reveal-delay="120"
        >
          {lead}
        </p>
      )
    }
    <slot />
  </div>
</div>
